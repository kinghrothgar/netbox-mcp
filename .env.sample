# Every variable here has a matching `--<name>` CLI flag; see
# `python3 -m netbox_mcp --help`. CLI flags take precedence over env vars.

# NetBox base URL (no trailing slash).
# With `make run-dev` the container uses --network host, so any hostname
# the host can resolve (LAN, Tailscale MagicDNS, /etc/hosts) works.
NETBOX_URL=https://demo.netbox.dev/

# NetBox API token with read permissions
NETBOX_TOKEN=replace-me-with-a-real-token

# Target NetBox minor version. Supported: 4.5, 4.6. Defaults to 4.6.
# Overridden by the `--netbox-version` CLI flag if both are set.
NETBOX_VERSION=4.6

# Address the FastMCP HTTP transport binds to. 127.0.0.1 restricts the dev
# server to loopback; set to 0.0.0.0 to expose on all host interfaces.
MCP_HOST=127.0.0.1

# Port FastMCP HTTP transport binds to inside the container.
# The Makefile reads this value to map the host port to match.
MCP_PORT=8000
